<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral UI logic (view models, commands, session state). No WPF here, so it builds and is
       tested on Linux in the shared CI. The WPF shell is src/Diagnostic.Desktop. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Diagnostic.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diagnostic.Presentation.Tests" />
  </ItemGroup>

  <!-- Version 10.0.0 verified on nuget.org (Logging 10.0.0 depends on Abstractions >= 10.0.0). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\Adapters.Abstractions\Adapters.Abstractions.csproj" />
  </ItemGroup>

</Project>
