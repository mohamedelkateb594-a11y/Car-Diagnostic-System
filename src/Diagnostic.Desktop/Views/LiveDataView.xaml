<UserControl x:Class="Diagnostic.Desktop.Views.LiveDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Diagnostic.Desktop.Services"
             xmlns:controls="clr-namespace:Diagnostic.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}"
                       Text="{Binding [NavLiveData], Source={x:Static services:LocalizationService.Instance}}" />

            <Border Style="{StaticResource Badge.Border}"
                    Visibility="{Binding HasSimulatedData, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource Brush.Accent.Text}"
                           Text="{Binding [SimulatedBadge], Source={x:Static services:LocalizationService.Instance}}" />
            </Border>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{Binding [DtcRunScanFirst], Source={x:Static services:LocalizationService.Instance}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasScan}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Text.Secondary}"
                           Text="{Binding [LiveEcu], Source={x:Static services:LocalizationService.Instance}}" />
                <ComboBox MinWidth="240" ItemsSource="{Binding AvailableEcus}"
                          SelectedItem="{Binding SelectedEcu, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Command="{Binding StartCommand}"
                        Content="{Binding [LiveStart], Source={x:Static services:LocalizationService.Instance}}" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Command="{Binding StopCommand}"
                        Content="{Binding [LiveStop], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,12,0,4" TextWrapping="Wrap"
                       Text="{Binding [LiveParams], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBox Text="{Binding ParameterIdsText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LocalizeConverter}">
                        <Binding Path="StatusKey" />
                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding StatusDetail}" />

            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Series}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="12" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Text="{Binding LatestText}" />
                                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding Name}" />
                                </DockPanel>
                                <controls:Sparkline Height="60" Margin="0,8,0,0"
                                                    Values="{Binding Values}"
                                                    Stroke="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
