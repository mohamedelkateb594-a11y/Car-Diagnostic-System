<UserControl x:Class="Diagnostic.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Diagnostic.Desktop.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Top">
        <TextBlock Style="{StaticResource Text.Title}">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <Binding Path="TitleKey" />
                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <TextBlock Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource Text.Secondary}"
                   Text="{Binding [PlaceholderNotImplemented], Source={x:Static services:LocalizationService.Instance}}" />

        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource Text.Secondary}"
                   Visibility="{Binding HasTaskReference, Converter={StaticResource BoolToVisibility}}">
            <Run Text="{Binding [TaskLabel], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding TaskReference, Mode=OneWay}" />
        </TextBlock>
    </StackPanel>
</UserControl>
