<Window x:Class="Diagnostic.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Diagnostic.Desktop.ViewModels"
        xmlns:views="clr-namespace:Diagnostic.Desktop.Views"
        Title="Car Diagnostic System"
        Width="1100" Height="700" MinWidth="800" MinHeight="500"
        Background="{DynamicResource Brush.Window.Background}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Nav.Background}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Bottom"
                        Margin="12"
                        Content="Toggle theme"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource Button.Default}" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="16,20,16,16"
                           Text="Car Diagnostic"
                           Style="{StaticResource Text.Title}"
                           FontSize="18" />
                <ListBox ItemsSource="{Binding Navigation.Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         DisplayMemberPath="Title"
                         Style="{StaticResource NavListBox}" />
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Margin="24"
                        Content="{Binding Navigation.Current}" />
    </Grid>
</Window>
