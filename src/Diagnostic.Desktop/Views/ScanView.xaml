<UserControl x:Class="Diagnostic.Desktop.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Diagnostic.Desktop.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Text.Title}"
                       Text="{Binding [NavScan], Source={x:Static services:LocalizationService.Instance}}" />

            <Border Style="{StaticResource Badge.Border}"
                    Visibility="{Binding Session.IsSimulated, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource Brush.Accent.Text}"
                           Text="{Binding [SimulatedBadge], Source={x:Static services:LocalizationService.Instance}}" />
            </Border>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{Binding [NotConnectedHint], Source={x:Static services:LocalizationService.Instance}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Session.IsActive}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Style="{StaticResource Button.Default}" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Command="{Binding RunCommand}"
                    Content="{Binding [ScanRun], Source={x:Static services:LocalizationService.Instance}}" />
            <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="{Binding IsBusy}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LocalizeConverter}">
                        <Binding Path="StatusKey" />
                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding StatusDetail}" />
        </StackPanel>

        <DataGrid Style="{StaticResource Data.Grid}" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding EcuId}" Width="90"
                                    Header="{Binding [ScanEcu], Source={x:Static services:LocalizationService.Instance}}" />
                <DataGridTextColumn Binding="{Binding DisplayName}" Width="2*"
                                    Header="{Binding [ScanName], Source={x:Static services:LocalizationService.Instance}}" />
                <DataGridTemplateColumn Width="*"
                                        Header="{Binding [ScanStatus], Source={x:Static services:LocalizationService.Instance}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="6,2">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizeConverter}">
                                        <Binding Path="StatusKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding DtcCount}" Width="70"
                                    Header="{Binding [ScanDtcCount], Source={x:Static services:LocalizationService.Instance}}" />
                <DataGridTextColumn Binding="{Binding Notes}" Width="2*"
                                    Header="{Binding [ScanNotes], Source={x:Static services:LocalizationService.Instance}}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
