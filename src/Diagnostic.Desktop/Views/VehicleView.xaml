<UserControl x:Class="Diagnostic.Desktop.Views.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Diagnostic.Desktop.Services">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.Title}"
                   Text="{Binding [NavVehicle], Source={x:Static services:LocalizationService.Instance}}" />

        <Border Style="{StaticResource Badge.Border}"
                Visibility="{Binding Session.IsSimulated, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{DynamicResource Brush.Accent.Text}"
                       Text="{Binding [SimulatedBadge], Source={x:Static services:LocalizationService.Instance}}" />
        </Border>

        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Session.IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=x}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Session.IsActive}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <TextBlock.Text>
                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" ConverterParameter="NotConnectedHint" />
            </TextBlock.Text>
        </TextBlock>

        <Button Style="{StaticResource Button.Default}" HorizontalAlignment="Left" Margin="0,16,0,0"
                Command="{Binding ReadCommand}"
                Content="{Binding [VehRead], Source={x:Static services:LocalizationService.Instance}}" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Text.Secondary}" Margin="0,4"
                       Text="{Binding [VehVin], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding VinText}" />
            <TextBlock Grid.Row="1" Style="{StaticResource Text.Secondary}" Margin="0,4"
                       Text="{Binding [VehMake], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding MakeText}" />
            <TextBlock Grid.Row="2" Style="{StaticResource Text.Secondary}" Margin="0,4"
                       Text="{Binding [VehModel], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding ModelText}" />
            <TextBlock Grid.Row="3" Style="{StaticResource Text.Secondary}" Margin="0,4"
                       Text="{Binding [VehYear], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding YearText}" />
            <TextBlock Grid.Row="4" Style="{StaticResource Text.Secondary}" Margin="0,4"
                       Text="{Binding [VehEngine], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding EngineText}" />
            <TextBlock Grid.Row="5" Style="{StaticResource Text.Secondary}" Margin="0,4"
                       Text="{Binding [VehMarket], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding MarketText}" />
        </Grid>

        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <Binding Path="VinStatusKey" />
                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="{Binding IsBusy}" />
        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <Binding Path="StatusKey" />
                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding StatusDetail}" />
    </StackPanel>
</UserControl>
