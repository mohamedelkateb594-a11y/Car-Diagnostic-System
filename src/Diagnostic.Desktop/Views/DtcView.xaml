<UserControl x:Class="Diagnostic.Desktop.Views.DtcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Diagnostic.Desktop.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Text.Title}"
                       Text="{Binding [NavDtc], Source={x:Static services:LocalizationService.Instance}}" />

            <Border Style="{StaticResource Badge.Border}"
                    Visibility="{Binding Session.IsSimulated, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource Brush.Accent.Text}"
                           Text="{Binding [SimulatedBadge], Source={x:Static services:LocalizationService.Instance}}" />
            </Border>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{Binding [DtcRunScanFirst], Source={x:Static services:LocalizationService.Instance}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasScan}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Text.Secondary}"
                           Text="{Binding [DtcEcu], Source={x:Static services:LocalizationService.Instance}}" />
                <ComboBox MinWidth="240" ItemsSource="{Binding AvailableEcus}"
                          SelectedItem="{Binding SelectedEcu, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Command="{Binding ReadCommand}"
                        Content="{Binding [DtcRead], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>

            <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="{Binding IsBusy}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LocalizeConverter}">
                        <Binding Path="StatusKey" />
                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding StatusDetail}" />
        </StackPanel>

        <DataGrid Style="{StaticResource Data.Grid}" ItemsSource="{Binding Dtcs}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Code}" Width="90"
                                    Header="{Binding [DtcCode], Source={x:Static services:LocalizationService.Instance}}" />
                <!-- The engine returns no DTC descriptions yet (no licensed text source); show a dash, not a guess. -->
                <DataGridTextColumn Binding="{Binding Description, TargetNullValue=—}" Width="3*"
                                    Header="{Binding [DtcDescription], Source={x:Static services:LocalizationService.Instance}}" />
                <DataGridTextColumn Binding="{Binding Status}" Width="*"
                                    Header="{Binding [DtcStatus], Source={x:Static services:LocalizationService.Instance}}" />
                <DataGridCheckBoxColumn Binding="{Binding IsConfirmed, Mode=OneWay}" Width="90"
                                        Header="{Binding [DtcConfirmed], Source={x:Static services:LocalizationService.Instance}}" />
                <DataGridCheckBoxColumn Binding="{Binding IsPending, Mode=OneWay}" Width="90"
                                        Header="{Binding [DtcPending], Source={x:Static services:LocalizationService.Instance}}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
