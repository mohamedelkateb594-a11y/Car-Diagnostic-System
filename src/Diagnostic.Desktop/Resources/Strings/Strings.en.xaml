    <sys:String x:Key="ToggleTheme">Toggle theme</sys:String>
    <sys:String x:Key="ToggleLanguage">العربية</sys:String>

    <sys:String x:Key="NavDashboard">Dashboard</sys:String>
    <sys:String x:Key="NavConnection">VCI Connection</sys:String>
    <sys:String x:Key="NavVehicle">Vehicle</sys:String>
    <sys:String x:Key="NavScan">Full Scan</sys:String>
