<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Diagnostic.Presentation.Tests</RootNamespace>
    <!-- xUnit1051 asks for the test cancellation token everywhere; tests use their own tokens (same as Diagnostic.Core.Tests). -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- Same package versions as tests/Diagnostic.Core.Tests, which the shared CI already restores. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\src\Adapters.Abstractions\Adapters.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Adapters.Mock\Adapters.Mock.csproj" />
    <ProjectReference Include="..\..\src\Diagnostic.Presentation\Diagnostic.Presentation.csproj" />
  </ItemGroup>

</Project>
